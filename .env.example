# Variáveis de ambiente necessárias em produção (configurar no painel do
# Vercel: Settings -> Environment Variables). Nunca commitar valores reais
# neste arquivo — ele serve só de referência.

# Painel do Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Segredo escolhido por você para proteger a rota de busca automática
# (usada pelo GitHub Actions). Pode ser qualquer texto longo e aleatório.
CRON_SECRET=

# App criado em developers.mercadolivre.com.br (Redirect URI precisa ser
# exatamente https://curadoria-ml.vercel.app/api/auth/mercadolivre/callback)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
